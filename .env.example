# Copy this file to .env and fill in your values. Never commit .env.

# --- LLM ---
# LLM_PROVIDER: mock | ollama | groq | openai_compatible
#   mock    fake answers, no model needed (tests, CI)
#   ollama  local model, free:  LLM_MODEL=qwen2.5:3b  (run `ollama pull qwen2.5:3b` first)
#   groq    free hosted tier:   LLM_MODEL=llama-3.3-70b-versatile, LLM_API_KEY=<your key>
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=
LLM_BASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=512
LLM_NUM_CTX=4096
LLM_TIMEOUT_SECONDS=300
ANSWER_TOP_K=5

# --- Paths (relative to the project root) ---
DATA_DIR=data
INDEX_DIR=indexes
LOG_DIR=logs

# --- Retrieval ---
CHUNK_SIZE=500
CHUNK_OVERLAP=80
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATES=20
RERANK_TOP_N=20
RRF_K=60

# --- SQL tool ---
SQL_ROW_LIMIT=100
SQL_TIMEOUT_SECONDS=5
